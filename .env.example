# WeCare — environment configuration (Vite: only VITE_-prefixed vars reach the client).
# Copy to `.env.local` for local dev. None of these are required for the current
# front-end prototype; they are the seams for the decided-but-not-yet-wired
# integrations. All hosting / sub-processors must be EU/EEA region (owner
# decision D16).

# --- Canonical site (owner decision D20) ---------------------------------------
# The real purchased domain. Used for canonical URLs, the sitemap, OG tags,
# cookie domain and API origins once set. While this is the placeholder
# `wecare.example`, VITE_SEO_INDEXABLE is ignored and the site stays noindex.
VITE_SITE_ORIGIN=https://wecare.example

# --- SEO indexing gate (docs/SEO-FOUNDATION.md §4) ----------------------------
# The WHOLE public site is noindex/nofollow until this is exactly "true" in
# production AND Product Owner + Austrian legal launch approval exists. Never
# flip it without that approval. Any other value (or unset) = noindex.
VITE_SEO_INDEXABLE=

# --- Organization schema (docs/SEO-FOUNDATION.md §23 / D9) -------------------
# Real registered legal name. Empty -> the Organization JSON-LD block is
# omitted entirely (never index placeholder company data). Fill from the real
# company register before the SEO go-live.
VITE_ORG_LEGAL_NAME=

# --- Analytics: PostHog EU (owner decision D17) ------------------------------
# Leave blank to keep analytics a no-op. When set, wire window.posthog in
# src/lib/analytics.ts `dispatch()`. Session recording MUST mask all inputs on
# the assessment and checkout routes. Never send raw assessment answers,
# name/email, DOB or documents (owner decision D16 — enforced in analytics.ts).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# --- Error reporting: GlitchTip / Sentry-compatible (owner decision D19) -----
# EU-hosted / self-hosted preferred. Scrub PII, health data, tokens before send.
# Wire in src/app/RootErrorBoundary.tsx `componentDidCatch()`.
VITE_ERROR_DSN=
